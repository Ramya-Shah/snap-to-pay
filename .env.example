# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model
# GEMINI_MODEL=gemini-3.5-flash-lite

# Razorpay TEST keys only (Dashboard → Test mode → API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: Upstash Redis (free tier) so rate limits hold across serverless instances.
# Without it, limits are counted in memory.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Public address used in links the WhatsApp bot sends
APP_URL=https://snap-to-pay.vercel.app

# WhatsApp bot (Meta Cloud API): developers.facebook.com > your app > WhatsApp
WHATSAPP_VERIFY_TOKEN=   # any random string; paste the same in Meta's webhook settings
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=     # App settings > Basic > App secret
# WHATSAPP_DRY_RUN=1     # log replies instead of sending (local testing)

# Razorpay webhook for the "paid" WhatsApp message (event: order.paid)
RAZORPAY_WEBHOOK_SECRET=
